{
  "name": "@msc-web/site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/stage.mjs && wrangler dev",
    "stage": "node scripts/stage.mjs",
    "deploy": "npm --prefix ../.. run build && wrangler d1 migrations apply msc-web --remote && wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply msc-web --local",
    "migrate:remote": "wrangler d1 migrations apply msc-web --remote",
    "seed:local": "wrangler d1 execute msc-web --local --file seed/dev.sql",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@msc-web/content": "*",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8",
    "wrangler": "^4.0.0"
  }
}
