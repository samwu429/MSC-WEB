# Dependencies
node_modules/

# Build output. apps/site/public is staged from apps/site/static and the admin build.
# 构建产物。apps/site/public 由 apps/site/static 与后台构建结果组装而成。
dist/
apps/site/public/
.wrangler/
*.tsbuildinfo

# Local secrets and environment. Real values live here or in Cloudflare secrets, never in git.
# 本地密钥与环境变量。真实值只存在于此处或 Cloudflare secrets，不进入 git。
.env
.env.*
.dev.vars
.dev.vars.*
!.dev.vars.example

# Editor and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
